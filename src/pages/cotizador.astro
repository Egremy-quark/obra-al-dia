---
import Base from '../layouts/Base.astro';
import precios from '../data/precios.json';
import sitio from '../data/sitio.json';
const fecha = new Date(precios.actualizado + 'T12:00:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Cotizador de obra · Obra al Día" description="Calcula cemento, gravilla, grava, block y varilla para tu firme, losa, muro o aplanado, con precios de la zona." active="cotizador">
  <div class="wrap page">
    <div class="intro">
      <p class="eyebrow">Precios al {fecha}</p>
      <h1 class="display page-t">Cotizador de obra</h1>
      <p class="lead">Elige tu obra, pon las medidas y junta todo en una sola cotización. Cuando esté lista, mándala por WhatsApp.</p>
    </div>

    <div class="grid">
      <section class="panel" aria-labelledby="t-obra">
        <p class="eyebrow">Paso 1</p>
        <h2 id="t-obra" class="h2 sm">¿Qué vas a construir?</h2>
        <div class="tabs" role="tablist" id="tabs"></div>
        <p class="desc" id="desc"></p>
        <div class="fields" id="fields"></div>
        <div class="plano"><svg id="plano" viewBox="0 0 320 190" role="img" aria-label="Plano con medidas"></svg><p class="cap mono" id="cap"></p></div>
        <div class="facts" id="facts"></div>
      </section>

      <section class="panel" aria-labelledby="t-mat">
        <p class="eyebrow">Paso 2</p>
        <h2 id="t-mat" class="h2 sm">Material que necesitas</h2>
        <div class="tablewrap"><table>
          <thead><tr><th>Material</th><th class="n">Compra</th><th class="n pr">Precio</th><th class="n">Importe</th></tr></thead>
          <tbody id="lines"></tbody>
        </table></div>
        <div class="total"><span>Total de esta obra</span><strong id="tot">$0</strong></div>
        <div class="actions"><button class="btn primary" id="add" type="button">Agregar a mi cotización</button></div>
        <p class="toast" id="toast" aria-live="polite"></p>
      </section>
    </div>

    <section class="panel" aria-labelledby="t-cot">
      <p class="eyebrow">Paso 3</p>
      <h2 id="t-cot" class="h2 sm">Mi cotización</h2>
      <div id="cotEmpty" class="empty"><strong>Todavía no agregas ninguna obra</strong>Calcula una arriba y dale “Agregar a mi cotización”. Puedes juntar varias: el firme, el muro y su aplanado.</div>
      <div id="cotBody" class="stack" hidden>
        <div class="chips" id="chips"></div>
        <div class="tablewrap"><table>
          <thead><tr><th>Material</th><th class="n">Compra</th><th class="n pr">Precio</th><th class="n">Importe</th></tr></thead>
          <tbody id="cotLines"></tbody>
        </table></div>
        <div class="total"><span>Total estimado</span><strong id="cotTot">$0</strong></div>
        <div class="actions">
          <button class="btn ghost" id="copy" type="button">Copiar lista</button>
          <button class="btn ghost" id="clear" type="button">Vaciar</button>
        </div>
        <p class="toast" id="toast2" aria-live="polite"></p>
        <textarea class="copybox mono" id="copybox" readonly hidden aria-label="Texto de la cotización"></textarea>
      </div>
    </section>

    <section class="panel lead-box" aria-labelledby="t-lead">
      <div class="lead-copy">
        <p class="eyebrow">Paso 4</p>
        <h2 id="t-lead" class="h2 sm">Manda tu cotización por WhatsApp</h2>
        <p>Te confirmamos precio, existencia y cuánto sale el flete a tu colonia.</p>
        <p class="fine" id="waNota">Se manda la obra que tengas en pantalla, o todas las que agregaste a “Mi cotización”.</p>
      </div>
      <form id="waForm" class="form">
        <div class="field"><label for="f-nombre">Tu nombre</label><input id="f-nombre" name="nombre" autocomplete="name" /></div>
        <div class="field"><label for="f-col">Colonia o localidad</label><input id="f-col" name="colonia" /></div>
        <div class="field full"><label for="f-cuando">¿Cuándo empiezas?</label>
          <select id="f-cuando" name="cuando"><option value="">Prefiero no decir</option><option>Esta semana</option><option>Este mes</option><option>En 1 a 3 meses</option><option>Solo estoy cotizando</option></select></div>
        <div class="actions full"><button class="btn wa big" type="submit" id="send">Enviar por WhatsApp</button></div>
        <p class="fine full">Se abre WhatsApp con tu lista ya escrita; solo le das enviar.</p>
      </form>
    </section>

    <section class="notes" aria-label="Cómo se calcula">
      <div><h3>De dónde salen los precios</h3>Precios de venta con IVA al {fecha}. Fuente: {precios.fuente} Son de referencia y pueden cambiar.</div>
      <div><h3>Qué incluye</h3><ul><li>5% de desperdicio en concreto, block y acero; 10% en aplanado.</li><li>Gravillas y grava se venden desde medio metro y por medios: si necesitas 1.3 m³, se cotiza 1.5 m³.</li><li>El concreto lleva gravilla fina con grava o gravilla normal; el block y el enjarre, cemento con gravilla fina.</li></ul></div>
      <div><h3>Qué no incluye</h3><ul><li>Mano de obra, cimbra, agua, flete ni herramienta.</li><li>Cálculo estructural: para losas y muros de carga consulta a un ingeniero o maestro de obra.</li></ul></div>
    </section>
  </div>
</Base>

<script>
  import { enviarPedido } from '../lib/whatsapp.js';
  import { activarEventos } from '../lib/umami.js';
  window.obraEnviarPedido = enviarPedido;
  activarEventos();
</script>
<script is:inline define:vars={{ PRECIOS: precios, WHATSAPP: sitio.whatsapp }}>
(function(){
const P=PRECIOS.productos, AG=PRECIOS.agregados;
const ORDER=['cemento','arena','gravillaF','gravillaN','grava','blockH','blockT','varilla','armex10','armex15','alambre'];
const MIX={150:[7,0.55,0.65],200:[8,0.52,0.65],250:[9,0.48,0.65]};
const mxn=new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN',maximumFractionDigits:0});
const mxn2=new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN',minimumFractionDigits:0,maximumFractionDigits:2});
const nf=(v,d)=>v.toLocaleString('es-MX',{minimumFractionDigits:d,maximumFractionDigits:d});
function addConcrete(need,vol,fc,g){g=g||'grava';const m=MIX[fc];need.cemento=(need.cemento||0)+vol*m[0];need.gravillaF=(need.gravillaF||0)+vol*m[1];need[g]=(need[g]||0)+vol*m[2];}
const GRUESO={k:'g',l:'Grava o gravilla',sel:[['grava','Grava'],['gravillaN','Gravilla normal']],v:'grava'};
const OBRAS={
  firme:{t:'Firme',d:'Piso de concreto colado sobre el terreno: patio, cochera o el piso de un cuarto.',
    f:[{k:'L',l:'Largo',u:'m',v:5,s:0.1},{k:'A',l:'Ancho',u:'m',v:4,s:0.1},{k:'e',l:'Espesor',u:'cm',v:8,s:1},{k:'fc',l:'Resistencia',sel:[['150',"f'c 150 · piso normal"],['200',"f'c 200 · cochera"]],v:'150'},GRUESO],
    calc(x){const vol=x.L*x.A*x.e/100*1.05;const need={};addConcrete(need,vol,x.fc,x.g);
      return {need,facts:['Área '+nf(x.L*x.A,2)+' m²','Concreto '+nf(vol,2)+' m³'],title:'Firme '+nf(x.L,2)+'×'+nf(x.A,2)+' m'};},plan:'planta'},
  losa:{t:'Losa',d:'Techo de concreto armado con parrilla de varilla de 3/8" en dos sentidos.',
    f:[{k:'L',l:'Largo',u:'m',v:5,s:0.1},{k:'A',l:'Ancho',u:'m',v:4,s:0.1},{k:'e',l:'Espesor',u:'cm',v:10,s:1},{k:'sep',l:'Varilla a cada',sel:[['15','15 cm'],['20','20 cm'],['25','25 cm']],v:'20'},{k:'fc',l:'Resistencia',sel:[['200',"f'c 200"],['250',"f'c 250"]],v:'200'},GRUESO],
    calc(x){const vol=x.L*x.A*x.e/100*1.05;const need={};addConcrete(need,vol,x.fc,x.g);
      const s=x.sep/100;const nL=Math.ceil(x.A/s)+1,nA=Math.ceil(x.L/s)+1;
      const m=(nL*(x.L+0.4)+nA*(x.A+0.4))*1.05;need.varilla=m/12;need.alambre=Math.max(1,m*0.557*0.03);
      return {need,facts:['Área '+nf(x.L*x.A,2)+' m²','Concreto '+nf(vol,2)+' m³',nf(m,0)+' m de varilla'],title:'Losa '+nf(x.L,2)+'×'+nf(x.A,2)+' m'};},plan:'losa'},
  muro:{t:'Muro',d:'Barda o muro de block de 10 cm pegado con cemento y gravilla fina, con castillos y dala de cerramiento.',
    f:[{k:'L',l:'Largo',u:'m',v:6,s:0.1},{k:'H',l:'Alto',u:'m',v:2.5,s:0.1},{k:'b',l:'Block',sel:[['blockH','Hueco 10×20×40'],['blockT','Tepezil 10×20×40']],v:'blockH'},{k:'c',l:'Castillos y dala',sel:[['1','Sí, cada 3 m'],['0','No']],v:'1'},GRUESO],
    calc(x){const area=x.L*x.H;const need={};need[x.b]=area*12.5*1.05;need.cemento=area*0.09;need.gravillaF=area*0.013;
      const facts=['Área '+nf(area,2)+' m²',Math.ceil(area*12.5*1.05)+' blocks'];
      if(x.c==='1'){const n=Math.ceil(x.L/3)+1;need.armex10=n*(x.H+0.3)/6;need.armex15=(x.L+0.3)/6;
        addConcrete(need,(n*0.15*0.15*x.H+0.15*0.2*x.L)*1.05,150,x.g);need.alambre=(need.alambre||0)+1;facts.push(n+' castillos');}
      return {need,facts,title:'Muro '+nf(x.L,2)+'×'+nf(x.H,2)+' m'};},plan:'muro'},
  aplanado:{t:'Aplanado',d:'Enjarre o repello rústico de cemento con gravilla fina. Si quieres el muro liso, agrega el acabado fino con arena de playa.',
    f:[{k:'L',l:'Largo del muro',u:'m',v:6,s:0.1},{k:'H',l:'Alto',u:'m',v:2.5,s:0.1},{k:'e',l:'Espesor',u:'cm',v:1.5,s:0.5},{k:'caras',l:'Caras',sel:[['1','Una cara'],['2','Las dos caras']],v:'1'},{k:'fino',l:'Acabado liso (extra)',sel:[['0','No, solo enjarre'],['1','Sí, con arena de playa']],v:'0'}],
    calc(x){const area=x.L*x.H*x.caras;const vol=area*x.e/100*1.1;const need={cemento:vol*7,gravillaF:vol*1.05};
      const facts=['Área '+nf(area,2)+' m²','Enjarre '+nf(vol,2)+' m³'];
      if(x.fino==='1'){const vf=area*0.005*1.1;need.cemento+=vf*7;need.arena=vf*1.05;facts.push('Acabado liso '+nf(vf,2)+' m³');}
      return {need,facts,title:'Aplanado '+nf(area,1)+' m²'+(x.fino==='1'?' + liso':'')};},plan:'muro'}
};
function buyAgg(k,m3){const n=Math.ceil(m3/0.5-1e-9);if(n<=0)return null;const a=AG[k];const tot=n*0.5;
  const cost=Math.floor(n/2)*a.metro+(n%2)*a.medio;
  return {name:a.nombre,sub:'Necesitas '+nf(m3,2)+' m³ · medio metro '+mxn2.format(a.medio),qty:(Number.isInteger(tot)?nf(tot,0):nf(tot,1))+' m³',price:mxn2.format(a.metro)+' / m³',total:cost};}
function lines(need){const out=[];ORDER.forEach(k=>{const v=need[k];if(!v||v<=0)return;
  if(AG[k]){const r=buyAgg(k,v);if(r)out.push(r);return;}
  const p=P[k];const q=Math.ceil(v-1e-9);out.push({name:p.nombre,sub:p.detalle,qty:q+' '+(q===1?p.unidad:p.plural),price:mxn2.format(p.precio),total:q*p.precio});});return out;}
function render(tb,ls){tb.innerHTML='';ls.forEach(l=>{const tr=document.createElement('tr');
  tr.innerHTML='<td>'+l.name+'<span class="sub">'+l.sub+'</span></td><td class="n mono">'+l.qty+'</td><td class="n pr">'+l.price+'</td><td class="n"><strong>'+mxn.format(l.total)+'</strong></td>';tb.appendChild(tr);});
  return ls.reduce((s,l)=>s+l.total,0);}

const $=id=>document.getElementById(id);
let cur=(location.hash||'').slice(1);if(!OBRAS[cur])cur='firme';
const vals={};Object.keys(OBRAS).forEach(k=>{vals[k]={};OBRAS[k].f.forEach(f=>vals[k][f.k]=f.v);});
const tabs=$('tabs');
Object.keys(OBRAS).forEach(k=>{const b=document.createElement('button');b.type='button';b.className='tab';b.id='tab-'+k;b.setAttribute('role','tab');b.textContent=OBRAS[k].t;
  b.addEventListener('click',()=>{cur=k;try{history.replaceState(null,'','#'+k);}catch(e){}build();});tabs.appendChild(b);});
window.addEventListener('hashchange',()=>{const h=location.hash.slice(1);if(OBRAS[h]&&h!==cur){cur=h;build();}});
function num(f){const v=parseFloat(String(vals[cur][f.k]).replace(',','.'));return isFinite(v)&&v>0?v:0;}
function getX(){const x={};OBRAS[cur].f.forEach(f=>{x[f.k]=f.sel?vals[cur][f.k]:num(f);});['fc','sep','caras'].forEach(k=>{if(x[k]!==undefined)x[k]=Number(x[k]);});return x;}
function build(){const o=OBRAS[cur];
  window.obraEvento('obra_calculada', { obra: cur });
  [...tabs.children].forEach(b=>b.setAttribute('aria-selected',b.id==='tab-'+cur?'true':'false'));
  $('desc').textContent=o.d;const fs=$('fields');fs.innerHTML='';
  o.f.forEach(f=>{const id='f-'+cur+'-'+f.k;const w=document.createElement('div');w.className='field';
    if(f.sel){w.innerHTML='<label for="'+id+'">'+f.l+'</label><div class="in"><select id="'+id+'">'+f.sel.map(s=>'<option value="'+s[0]+'"'+(String(vals[cur][f.k])===s[0]?' selected':'')+'>'+s[1]+'</option>').join('')+'</select></div>';}
    else{w.innerHTML='<label for="'+id+'">'+f.l+'</label><div class="in"><input id="'+id+'" type="number" inputmode="decimal" min="0" step="'+f.s+'" value="'+vals[cur][f.k]+'"><span class="u">'+f.u+'</span></div>';}
    fs.appendChild(w);const el=w.querySelector('input,select');el.addEventListener('input',()=>{vals[cur][f.k]=el.value;update();});});
  update();}
let last=null;
function update(){const o=OBRAS[cur];const x=getX();const ok=o.f.every(f=>f.sel||x[f.k]>0);
  if(!ok){$('lines').innerHTML='<tr><td colspan="4" class="desc">Pon todas las medidas mayores a cero.</td></tr>';$('tot').textContent='$0';$('facts').innerHTML='';$('add').disabled=true;last=null;drawPlan(o,x);return;}
  const r=o.calc(x);last=r;$('add').disabled=false;
  $('facts').innerHTML=r.facts.map(t=>'<span class="fact mono">'+t+'</span>').join('');
  $('tot').textContent=mxn.format(render($('lines'),lines(r.need)));drawPlan(o,x);}
function drawPlan(o,x){const svg=$('plano');const W=320,H=190,pad=34;const a=(x.L||1),b=o.plan==='muro'?(x.H||1):(x.A||1);
  const sc=Math.min((W-pad*2)/a,(H-pad*2)/b);const w=a*sc,h=b*sc,x0=(W-w)/2,y0=(H-h)/2;let g='';
  const st='stroke="var(--plan)"',tx='fill="var(--plan)" font-family="IBM Plex Mono,monospace" font-size="11" text-anchor="middle"';
  if(o.plan==='losa'){const s=(x.sep||20)/100*sc;if(s>3){for(let i=x0+s;i<x0+w-1;i+=s)g+='<line x1="'+i+'" y1="'+y0+'" x2="'+i+'" y2="'+(y0+h)+'" '+st+' stroke-opacity=".35"/>';for(let j=y0+s;j<y0+h-1;j+=s)g+='<line x1="'+x0+'" y1="'+j+'" x2="'+(x0+w)+'" y2="'+j+'" '+st+' stroke-opacity=".35"/>';}}
  if(o.plan==='muro'){const rows=Math.max(1,Math.round((x.H||1)/0.2)),rh=h/rows,bw=0.4*sc;if(rh>2.5&&bw>4){for(let r=1;r<rows;r++)g+='<line x1="'+x0+'" y1="'+(y0+r*rh)+'" x2="'+(x0+w)+'" y2="'+(y0+r*rh)+'" '+st+' stroke-opacity=".25"/>';
      for(let r=0;r<rows;r++){const off=r%2?bw/2:0;for(let c=x0+off+bw;c<x0+w-1;c+=bw)g+='<line x1="'+c+'" y1="'+(y0+r*rh)+'" x2="'+c+'" y2="'+(y0+(r+1)*rh)+'" '+st+' stroke-opacity=".2"/>';}}
    if(cur==='muro'&&x.c==='1'){const n=Math.ceil((x.L||1)/3)+1;for(let i=0;i<n;i++){const cx=i===n-1?x0+w-6:x0+Math.min(w-6,i*3*sc);g+='<rect x="'+cx+'" y="'+y0+'" width="6" height="'+h+'" fill="var(--plan)" fill-opacity=".55"/>';}g+='<rect x="'+x0+'" y="'+y0+'" width="'+w+'" height="6" fill="var(--plan)" fill-opacity=".55"/>';}}
  g+='<rect x="'+x0+'" y="'+y0+'" width="'+w+'" height="'+h+'" fill="var(--plan-soft)" '+st+' stroke-width="2"/>';
  g+='<line x1="'+x0+'" y1="'+(y0-14)+'" x2="'+(x0+w)+'" y2="'+(y0-14)+'" '+st+'/><line x1="'+x0+'" y1="'+(y0-19)+'" x2="'+x0+'" y2="'+(y0-9)+'" '+st+'/><line x1="'+(x0+w)+'" y1="'+(y0-19)+'" x2="'+(x0+w)+'" y2="'+(y0-9)+'" '+st+'/>';
  g+='<text x="'+(x0+w/2)+'" y="'+(y0-19)+'" '+tx+'>'+nf(a,2)+' m</text>';
  g+='<line x1="'+(x0+w+14)+'" y1="'+y0+'" x2="'+(x0+w+14)+'" y2="'+(y0+h)+'" '+st+'/><line x1="'+(x0+w+9)+'" y1="'+y0+'" x2="'+(x0+w+19)+'" y2="'+y0+'" '+st+'/><line x1="'+(x0+w+9)+'" y1="'+(y0+h)+'" x2="'+(x0+w+19)+'" y2="'+(y0+h)+'" '+st+'/>';
  g+='<text '+tx+' transform="translate('+(x0+w+26)+' '+(y0+h/2)+') rotate(90)">'+nf(b,2)+' m</text>';
  svg.innerHTML=g;
  $('cap').textContent=o.plan==='muro'?'Vista de frente'+(cur==='muro'&&x.c==='1'?' · castillos y dala en azul':''):(o.plan==='losa'?'Vista de planta · parrilla a cada '+(x.sep||20)+' cm':'Vista de planta · espesor '+nf(x.e||0,0)+' cm');}

const cot=[];let cotLs=[];
function toast(id,t){const el=$(id);el.textContent=t;clearTimeout(el._t);el._t=setTimeout(()=>{el.textContent='';},4000);}
$('add').addEventListener('click',()=>{if(!last)return;window.obraEvento('obra_agregada', { obra: cur });cot.push({title:last.title,need:{...last.need}});renderCot();toast('toast','Agregado: '+last.title+'. Revisa “Mi cotización” abajo.');});
function merged(){const n={};cot.forEach(c=>Object.keys(c.need).forEach(k=>n[k]=(n[k]||0)+c.need[k]));return n;}
function cotText(){const t=cotLs.reduce((s,l)=>s+l.total,0);
  return ['Hola, quiero cotizar este material (Obra al Día):','Obras: '+cot.map(c=>c.title).join(', '),'',...cotLs.map(l=>'• '+l.name+': '+l.qty+' → '+mxn.format(l.total)),'','Total estimado: '+mxn.format(t),'¿Me confirman existencia y flete?'].join('\n');}
function renderCot(){const has=cot.length>0;$('cotEmpty').hidden=has;$('cotBody').hidden=!has;$('copybox').hidden=true;
  if(!has)return;
  $('chips').innerHTML='';cot.forEach((c,i)=>{const s=document.createElement('span');s.className='chip';s.innerHTML=c.title+'<button type="button" aria-label="Quitar '+c.title+'">×</button>';
    s.querySelector('button').addEventListener('click',()=>{cot.splice(i,1);renderCot();});$('chips').appendChild(s);});
  cotLs=lines(merged());$('cotTot').textContent=mxn.format(render($('cotLines'),cotLs));
  }
$('clear').addEventListener('click',()=>{cot.length=0;renderCot();});
$('copy').addEventListener('click',()=>{const txt=cotText();const box=$('copybox');
  const fb=()=>{box.value=txt;box.hidden=false;box.focus();box.select();toast('toast2','Selecciona el texto y cópialo.');};
  try{navigator.clipboard.writeText(txt).then(()=>toast('toast2','Lista copiada.'),fb);}catch(e){fb();}});

function obraText(){if(!last)return '';const ls=lines(last.need);const t=ls.reduce((x,l)=>x+l.total,0);
  return ['Hola, quiero cotizar este material (Obra al Día):','Obra: '+last.title,'',...ls.map(l=>'• '+l.name+': '+l.qty+' → '+mxn.format(l.total)),'','Total estimado: '+mxn.format(t),'¿Me confirman existencia y flete?'].join('\n');}
$('waForm').addEventListener('submit',e=>{e.preventDefault();
  let txt=cot.length?cotText():obraText();
  if(!txt){toast('toast','Pon tus medidas primero.');return;}
  const obra = cot.length ? cot.map(c => c.title).join(', ') : last.title;
  const total = cot.length ? cotLs.reduce((s, l) => s + l.total, 0) : lines(last.need).reduce((s, l) => s + l.total, 0);
  window.obraEvento('whatsapp_enviado', { obra, total });
  window.obraEnviarPedido(WHATSAPP, txt, { nombre: $('f-nombre').value, colonia: $('f-col').value, cuando: $('f-cuando').value });});

build();renderCot();
})();
</script>

<style>
.page{padding-block:28px 0;display:flex;flex-direction:column;gap:20px}
.intro{display:flex;flex-direction:column;gap:10px}
.page-t{font-size:clamp(44px,7vw,76px)}
.h2.sm{font-size:26px}
.grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:20px;align-items:start}
@media (max-width:820px){.grid{grid-template-columns:minmax(0,1fr)}}
.tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
@media (max-width:420px){.tabs{grid-template-columns:repeat(2,minmax(0,1fr))}}
:global(.tab){font:inherit;font-weight:600;font-size:14px;padding:10px 8px;border:1.5px solid var(--line);background:var(--sunk);color:var(--ink);border-radius:8px;cursor:pointer}
:global(.tab[aria-selected="true"]){background:var(--ink);color:var(--surface);border-color:var(--ink)}
